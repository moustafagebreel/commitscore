{
  "name": "commitscore",
  "version": "1.0.0",
  "description": "🔍 Analyze and improve your commit quality",
  "bin": {
    "commitscore": "bin/commit-lens.js",
    "commit-lens": "bin/commit-lens.js"
  },
  "main": "src/index.js",
  "scripts": {
    "build": "ncc build bin/commit-lens.js -o dist --license licenses.txt",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "format": "prettier --write ."
  },
  "keywords": [
    "git",
    "commit",
    "quality",
    "cli",
    "conventional-commits",
    "linting"
  ],
  "author": {
    "name": "Moustafa Gebreel",
    "url": "https://moustafagebreel.online"
  },
  "homepage": "https://moustafagebreel.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moustafagebreel/commitscore.git"
  },
  "bugs": {
    "url": "https://github.com/moustafagebreel/commitscore/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "compromise": "^14.10.0",
    "franc": "^5.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0"
  }
}
